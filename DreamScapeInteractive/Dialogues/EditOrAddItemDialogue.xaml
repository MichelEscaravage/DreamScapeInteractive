<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DreamScapeInteractive.Dialogues.EditOrAddItemDialogue"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamScapeInteractive.Dialogues"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CornerRadius="20"
    x:Name="EditItemDialogueFrame"
    PointerEntered="EditItemDialogueFrame_PointerEntered"
    PointerExited="EditItemDialogueFrame_PointerExited">

    <ScrollViewer x:Name="EditItemScrollViewer">
        <Grid Margin="0,0,39,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>

            </Grid.ColumnDefinitions>

            <StackPanel x:Name="EditItemPanel">
                <TextBlock x:Name="TitleBlock" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <TextBlock x:Name="Typeblock" FontSize="12" Foreground="Gold" Margin="0,0,0,2"/>
                <TextBox  x:Name="DescriptionBlock" Margin="0,0,0,20" Foreground="LightGray"/>
            </StackPanel>

            <StackPanel x:Name="AddItemPanel" Spacing="10">
                <TextBox x:Name="TitleBox" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,5" PlaceholderText="Add a title"/>
                <ListBox MaxHeight="150" x:Name="TypesListBox" SelectionMode="Single" FontSize="14" Foreground="#FEB710" Background="#5f6b4330"/>
                <TextBox  x:Name="DescriptionBox" Margin="0,0,0,20" Foreground="LightGray" MinHeight="100" PlaceholderText="Add a description"/>
            </StackPanel>

            <Grid Grid.Row="4">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <!-- Label for FilterBox -->
                    <RowDefinition Height="Auto" />
                    <!-- FilterBox -->
                    <RowDefinition Height="Auto" />
                    <!-- Label for Rarity -->
                    <RowDefinition Height="Auto" />
                    <!-- RaritySlider -->
                    <RowDefinition Height="Auto" />
                    <!-- Label for Power -->
                    <RowDefinition Height="Auto" />
                    <!-- PowerSlider -->
                    <RowDefinition Height="Auto" />
                    <!-- Label for Speed -->
                    <RowDefinition Height="Auto" />
                    <!-- SpeedSlider -->
                    <RowDefinition Height="Auto" />
                    <!-- Label for Durability -->
                    <RowDefinition Height="Auto" />
                    <!-- DurabilitySlider -->
                    <RowDefinition Height="*" />
                    <!-- ResetButton -->
                </Grid.RowDefinitions>

                <ListBox MaxHeight="300" Grid.Row="1" x:Name="MagicPropertyListBox" SelectionMode="Single" FontSize="14" Foreground="#FEB710" Background="#5f6b4330"/>

                <TextBlock x:Name="RarityLabel" Grid.Row="2" Text="Rarity" FontSize="14" Foreground="#FEB710" Margin="0,4" />
                <Slider Grid.Row="3" x:Name="RaritySlider" />

                <TextBlock x:Name="PowerLabel" Grid.Row="4" Text="Power" FontSize="14" Foreground="#FEB710" Margin="0,4" />
                <Slider Grid.Row="5" x:Name="PowerSlider" />

                <TextBlock x:Name="SpeedLabel" Grid.Row="6" Text="Speed" FontSize="14" Foreground="#FEB710" Margin="0,4" />
                <Slider Grid.Row="7" x:Name="SpeedSlider" />

                <TextBlock x:Name="DurabilityLabel" Grid.Row="8" Text="Durability" FontSize="14" Foreground="#FEB710" Margin="0,4" />
                <Slider Grid.Row="9" x:Name="DurabilitySlider" />

                <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button  x:Name="SaveButton" Click="SaveButton_Click"  Content="Save Edit" Foreground="Yellow" Background="DarkGreen"/>
                    <Button  x:Name="CancelButton" Click="CancelButton_Click"  Content="Cancel" Foreground="Yellow" Margin="30,0,0,0"/>
                </StackPanel>
            </Grid>


        </Grid>
    </ScrollViewer>
</ContentDialog>
