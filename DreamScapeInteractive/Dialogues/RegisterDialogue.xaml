<ContentDialog
    x:Class="DreamScapeInteractive.Dialogues.RegisterDialogue"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamScapeInteractive.Dialogues"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#3b2f2f">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <TextBlock
            x:Name="ErrorBlock"
            Visibility="Collapsed"
            Foreground="Red"
        />

        <!-- Title -->
        <TextBlock
            Text="⚔ Register a New User ⚔"
            Foreground="Gold"
            FontSize="20"
            FontFamily="Garamond"
            FontWeight="Bold"
            Grid.Row="1"
            HorizontalAlignment="Center"
            Margin="0,0,0,20"
        />

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Width="290" Spacing="10">

            <!-- Username -->
            <TextBlock Text="Username:" 
                       Foreground="Gold"
                       FontSize="16"
                       FontFamily="Garamond"
                       HorizontalAlignment="Center"/>

            <TextBox
                    x:Name="UserNameTextbox"
                    PlaceholderText="Enter Username"
                    Background="#704214"
                    Foreground="White"
                    BorderBrush="Gold"
                    FontSize="16"
                    FontFamily="Garamond"
                    Width="250"
                    TextAlignment="Center"/>

            <!-- Email Address -->
            <TextBlock Text="Email Address:" 
                       Foreground="Gold"
                       FontSize="16"
                       FontFamily="Garamond"
                       HorizontalAlignment="Center"/>

            <TextBox 
                x:Name="EmailAdressBox"
                PlaceholderText="Enter Email"
                Background="#704214"
                Foreground="White"
                BorderBrush="Gold"
                FontSize="16"
                FontFamily="Garamond"
                Width="250"
                TextAlignment="Center"/>

            <!-- Generate Password Button -->
            <Button 
                x:Name="GeneratePassword"
                Click="GeneratePassword_Click"
                Content="🛡 Generate Random Password"
                Background="#704214"
                Foreground="White"
                BorderBrush="Gold"
                BorderThickness="3"
                FontSize="16"
                FontFamily="Garamond"
                Width="250"
                HorizontalAlignment="Center"/>

            <StackPanel Orientation="Vertical">
                <!-- Password Box -->
                <PasswordBox
                    x:Name="PasswordTextBox"
                    PlaceholderText="Enter your password..."
                    Background="#704214"
                    Foreground="White"
                    BorderBrush="Gold"
                    FontSize="15"
                    FontFamily="Garamond"
                    CornerRadius="10"
                    Margin="10"
                    Visibility="Collapsed"
                    PasswordChanged="PasswordTextBox_PasswordChanged"
                    
                />

                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="confirmPasswordLabel" Grid.Row="0" FontSize="12" Foreground="#e41828" FontFamily="Consolas"/>
                    <!-- Password Box -->
                    <PasswordBox
                        x:Name="ConfirmPasswordTextBox"
                        PlaceholderText="Confirm your password..."
                        Background="#704214"
                        Foreground="White"
                        BorderBrush="Gold"
                        FontSize="15"
                        FontFamily="Garamond"
                        CornerRadius="10"
                        Margin="10"
                        Visibility="Collapsed"
                        PasswordChanged="ConfirmPasswordTextBox_PasswordChanged"
                    />
                </StackPanel>
                
            </StackPanel>
            <ToggleSwitch x:Name="IsAdminSwitch"
              Toggled="IsAdminSwitch_Toggled"
              OnContent="Admin" 
              OffContent="Player"
              Foreground="#FFD700"
              RequestedTheme="Dark"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                <Button 
                        x:Name="RegisterButton"
                        Content="Register" 
                        Background="#8b5a2b"
                        Foreground="White"
                        BorderThickness="3"
                        FontSize="16"
                        FontFamily="Garamond"
                        Width="100"
                        Margin="0,30,0,0"
                        Click="RegisterButton_Click"/>

                <Button 
                    x:Name="CancelButton"
                    Click="CancelButton_Click"
                    Content="Cancel" 
                    Background="#8b5a2b"
                    Foreground="White"
                    BorderThickness="3"
                    FontSize="16"
                    FontFamily="Garamond"
                    Width="100"
                    Margin="0,30,0,0"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</ContentDialog>
