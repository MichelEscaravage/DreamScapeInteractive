<Page
    x:Class="DreamScapeInteractive.CatalogusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamScapeInteractive"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localData="using:DreamScapeInteractive.Data.Classes"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="#3b2f2f" Padding="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Background="#8b5a2b" CornerRadius="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                <Button  Margin="10,0,0,0" CornerRadius="10,0,0,10" x:Name="BackButton"  Content="Back" Click="BackButton_Click" Loaded="BackButton_Loaded" Background="#704214" BorderBrush="Gold"/>
                <Button x:Name="AddItemButton" Click="AddItemButton_Click"  Margin="10,0,0,0" CornerRadius="0,10,10,0" Grid.Column="1" Content="Add Item" Background="#704214" BorderBrush="Gold" />

            </StackPanel>
            <TextBox MinWidth="150"  Background="#5a0000" Grid.Column="2" PlaceholderText="Search..." x:Name="SearchItemsBox" TextChanged="SearchItemsBox_TextChanged" HorizontalAlignment="Right" />
            <TextBlock Foreground="Gold" Grid.Column="1" HorizontalAlignment="Center" Text="CATALOGUS" FontSize="20"/>

            <Button x:Name="FilterButton" Grid.Column="3" HorizontalAlignment="Right" Width="50" Height="50" Padding="0" Background="Transparent">
                <Image Source="Assets/sort.jpg" Stretch="Uniform" Width="40" Height="40" Margin="5"/>
                <Button.Flyout>
                    <Flyout>
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <!-- Label for FilterBox -->
                                <RowDefinition Height="Auto" />
                                <!-- FilterBox -->
                                <RowDefinition Height="Auto" />
                                <!-- Label for Rarity -->
                                <RowDefinition Height="Auto" />
                                <!-- RaritySlider -->
                                <RowDefinition Height="Auto" />
                                <!-- Label for Power -->
                                <RowDefinition Height="Auto" />
                                <!-- PowerSlider -->
                                <RowDefinition Height="Auto" />
                                <!-- Label for Speed -->
                                <RowDefinition Height="Auto" />
                                <!-- SpeedSlider -->
                                <RowDefinition Height="Auto" />
                                <!-- Label for Durability -->
                                <RowDefinition Height="Auto" />
                                <!-- DurabilitySlider -->
                                <RowDefinition Height="Auto" />
                                <!-- ResetButton -->
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Filters" FontSize="16" Foreground="#FEB710" Margin="0,4" />
                            <ListBox SelectionChanged="FilterBox_SelectionChanged" MaxHeight="450" Grid.Row="1" x:Name="FilterBox" SelectionMode="Single" FontSize="14" Foreground="#FEB710" Background="Transparent" />

                            <TextBlock Grid.Row="2" Text="Rarity" FontSize="14" Foreground="#FEB710" Margin="0,4" />
                            <Slider Grid.Row="3" x:Name="RaritySlider" ValueChanged="FilterSlider_ValueChanged" />

                            <TextBlock Grid.Row="4" Text="Power" FontSize="14" Foreground="#FEB710" Margin="0,4" />
                            <Slider Grid.Row="5" x:Name="PowerSlider" ValueChanged="FilterSlider_ValueChanged" />

                            <TextBlock Grid.Row="6" Text="Speed" FontSize="14" Foreground="#FEB710" Margin="0,4" />
                            <Slider Grid.Row="7" x:Name="SpeedSlider" ValueChanged="FilterSlider_ValueChanged" />

                            <TextBlock Grid.Row="8" Text="Durability" FontSize="14" Foreground="#FEB710" Margin="0,4" />
                            <Slider Grid.Row="9" x:Name="DurabilitySlider" ValueChanged="FilterSlider_ValueChanged" />

                            <Button Grid.Row="10" x:Name="ResetFiltersButton" Click="ResetFiltersButton_Click"  Content="Reset all filters"/>

                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>

        </Grid>
        <ScrollViewer x:Name="ItemCatalogusScrollViewer" Grid.Row="1" IsScrollInertiaEnabled="True">
            <GridView  
                x:Name="ItemCatalogusGrid" HorizontalAlignment="Center" 
                PointerEntered="ItemCatalogusGrid_PointerEntered" 
                PointerExited="ItemCatalogusGrid_PointerExited" 
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                Margin="10" 
                HorizontalContentAlignment="Center" 
                VerticalContentAlignment="Center">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="localData:Item">
                        <Border MinWidth="300" Margin="10" 
                                Padding="15"  
                                Background="#704214"
                                BorderBrush="Gold"
                                BorderThickness="3" CornerRadius="8">
                            <Grid x:Name="ItemCatalogusGrid2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Item ID -->

                                <!-- Item Name -->
                                <TextBlock x:Name="ItemNameBlock" Text="{x:Bind Name}" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,10,5"/>

                                <!-- Type -->
                                <TextBlock x:Name="ItemTypeBlock" Text="{x:Bind Type.Name}" Grid.Row="1" FontSize="12" Foreground="Gold" Margin="0,0,10,5"/>

                                <!-- Item Description -->
                                <TextBlock x:Name="ItemDescriptionBlock" Text="{x:Bind Description}" Grid.Row="2" TextWrapping="WrapWholeWords" Foreground="LightGray" Margin="0,0,10,10"/>

                                <!-- Magic Property -->
                                <TextBlock x:Name="ItemMagicPropertyBlock" Text="{x:Bind MagicProperty.Name}" Grid.Row="3" FontSize="16" Foreground="Gold" FontStyle="Italic" Margin="0,0,10,5"/>

                                <!-- Stats -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="15">
                                    <!-- Left Side (Rarity, Power) -->
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                                        <TextBlock Text="Rarity:" FontSize="14" Foreground="White"/>
                                        <TextBlock x:Name="ItemRarityBlock" Text="{x:Bind Rarity}" FontSize="16" Foreground="LightGreen"/>

                                        <TextBlock Text="Power:" FontSize="14" Foreground="White"/>
                                        <TextBlock x:Name="ItemPowerBlock" Text="{x:Bind Power}" FontSize="16" Foreground="LightCoral"/>
                                    </StackPanel>

                                    <!-- Right Side (Speed, Durability) -->
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                                        <TextBlock Text="Speed:" FontSize="14" Foreground="White"/>
                                        <TextBlock x:Name="ItemSpeedBlock" Text="{x:Bind Speed}" FontSize="16" Foreground="SkyBlue"/>

                                        <TextBlock Text="Durability:" FontSize="14" Foreground="White"/>
                                        <TextBlock x:Name="ItemDurabilityBlock" Text="{x:Bind Durability}" FontSize="16" Foreground="LightGoldenrodYellow"/>
                                    </StackPanel>
                                    
                                    <Button
                                        x:Name="EditButton"
                                        Click="EditButton_Click"
                                        Content="Edit"
                                        VerticalAlignment="Bottom"
                                        Background="#701714" 
                                        BorderBrush="Gold"
                                        FontSize="12"
                                        CommandParameter="{Binding}"
                                        Loaded="EditButton_Loaded"
                                    />


                                    <Button
                                        x:Name="DeleteButton"
                                        Click="DeleteButton_Click"
                                        VerticalAlignment="Bottom"
                                        Content="Delete"
                                        Background="#701714" 
                                        BorderBrush="Gold"
                                        FontSize="12"
                                        Loaded="DeleteButton_Loaded"
                                        CommandParameter="{Binding}"
                                    />

                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>
    </Grid>
</Page>
