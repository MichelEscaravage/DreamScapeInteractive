<Page
    x:Class="DreamScapeInteractive.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamScapeInteractive"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Grid  Background="#3b2f2f" Padding="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Medieval Header -->
        <Grid  Background="#5a0000" CornerRadius="20">
            <TextBlock Text="DreamScape Interactive Login" 
                       FontSize="36" 
                       FontWeight="Bold"
                       FontFamily="Garamond"
                       Foreground="Gold"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
        </Grid>

        <!-- Hogwarts Crest -->
        <Image Grid.Row="1" Source="Assets\logo.webp"
               MaxWidth="200"
               MaxHeight="200"
            />

        <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="20">
            <Grid  RowSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>


                <!-- Username TextBox -->
                <TextBox
                x:Name="UsernameTextBox"
                PlaceholderText="Enter your name..."
                Grid.Row="1"
                Background="#704214"
                Foreground="White"
                BorderBrush="Gold"
                FontSize="20"
                FontFamily="Garamond"
                CornerRadius="10"
                Margin="10"/>

                <!-- Password Box -->
                <PasswordBox
                x:Name="PasswordTextBox"
                PlaceholderText="Enter your password..."
                Grid.Row="2"
                Background="#704214"
                Foreground="White"
                BorderBrush="Gold"
                FontSize="20"
                FontFamily="Garamond"
                CornerRadius="10"
                Margin="10"/>

                <StackPanel Orientation="Horizontal"  Grid.Row="3">
                    <!-- Login Button -->
                    <Button
                        x:Name="LoginButton"
                        Click="LoginButton_Click"
                        HorizontalAlignment="Center"
                        Content="🔑 Login"
                        Background="#8b5a2b"
                        Foreground="Gold"
                        BorderBrush="Gold"
                        FontSize="18"
                        FontFamily="Garamond"
                        CornerRadius="10"
                        Margin="10"
                    />

                    <Button
                        x:Name="RegisterButton"
                        Click="RegisterButton_Click"
                        HorizontalAlignment="Center"
                        Content="Register a new account!"
                        Background="#8b5a2b"
                        Foreground="Gold"
                        BorderBrush="Gold"
                        FontSize="18"
                        FontFamily="Garamond"
                        CornerRadius="10"
                        Margin="10"
                    />

                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>